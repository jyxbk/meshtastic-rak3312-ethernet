diff --git a/variants/esp32s3/rak3312/platformio.ini b/variants/esp32s3/rak3312/platformio.ini
index ca2d702..37bfc6f 100644
--- a/variants/esp32s3/rak3312/platformio.ini
+++ b/variants/esp32s3/rak3312/platformio.ini
@@ -21,6 +21,30 @@ build_flags =
   -D RAK3312
   -I variants/esp32s3/rak3312
 
+; RAK3312 + RAK13800 (WIZnet W5100S-L) Ethernet module, optionally powered via RAK19018 PoE.
+; Separate env (like rak4631_eth_gw) so the plain rak3312 build is unchanged.
+[env:rak3312_eth_gw]
+extends = env:rak3312
+board_level = release
+
+build_flags =
+  ${env:rak3312.build_flags}
+  -D RAK3312_ETH_GW
+
+custom_sdkconfig =
+  ${esp32s3_base.custom_sdkconfig}
+  CONFIG_ETH_ENABLED=y
+  CONFIG_ARDUINO_SELECTIVE_Ethernet=y
+
+build_src_filter =
+  ${esp32s3_base.build_src_filter}
+  +<mesh/eth/>
+
+lib_deps =
+  ${esp32s3_base.lib_deps}
+  # renovate: datasource=github-tags depName=RAK13800-W5100S packageName=RAKWireless/RAK13800-W5100S
+  https://github.com/RAKWireless/RAK13800-W5100S/archive/1.0.4.zip
+
 [env:rak3112]
 extends = esp32s3_base
 board = wiscore_rak3312
